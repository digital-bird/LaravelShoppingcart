{
    "name": "digital-bird/shoppingcart",
    "description": "Laravel Shoppingcart",
    "keywords": [
        "laravel",
        "shoppingcart"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Rob Gloudemans",
            "email": "info@robgloudemans.nl"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "12.*|13.*",
        "illuminate/session": "12.*|13.*",
        "illuminate/events": "12.*|13.*"
    },
    "require-dev": {
        "phpunit/phpunit": "~11.0|~12.0",
        "mockery/mockery": "^1.0",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Gloudemans\\Shoppingcart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gloudemans\\Tests\\Shoppingcart\\": "tests/"
        }
    },
    "suggest": {
        "gloudemans/notify": "Simple flash notifications for Laravel"
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Gloudemans\\Shoppingcart\\ShoppingcartServiceProvider"
            ],
            "aliases": {
                "Cart": "Gloudemans\\Shoppingcart\\Facades\\Cart"
            }
        }
    }
}
